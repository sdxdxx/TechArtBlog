# ==========================================
# 1. Obsidian 本地账号、API 与运行时状态
# ==========================================
# 只忽略会写入凭据的用户数据；插件程序文件仍可同步。
content/.obsidian/plugins/obsidian-translator/data.json
content/.obsidian/plugins/quickadd/data.json
content/.obsidian/plugins/obsidian-excalidraw-plugin/data.json
content/.obsidian/plugins/editing-toolbar/data.json
content/.obsidian/plugins/obsidian42-brat/data.json
content/.obsidian/plugins/opencode-obsidian/data.json

# 迁移/完整性报告和资源包是每台设备的可重建状态。
content/.obsidian/plugins/xd-attachment-manager/data.json
content/.obsidian/plugins/xd-code-renderer/packs/installed.json
content/.obsidian/plugins/xd-code-renderer/packs/installed/

# 登录 Cookie 与会话信息不进入 Git。
content/.obsidian/zhihu-data.json

# ==========================================
# 2. 屏蔽 Obsidian 内部缓存与本地设置
# ==========================================
content/.obsidian/workspace.json
content/.obsidian/workspace-mobile.json
content/.obsidian/cache/
content/.obsidian/indexed-db/

# ==========================================
# 3. 屏蔽 Quartz/Node.js 开发冗余
# ==========================================
node_modules/
public/
.quartz-cache/

# ==========================================
# 4. 屏蔽操作系统垃圾文件
# ==========================================
.DS_Store
Thumbs.db
*.log

# ==========================================
# 5. 屏蔽敏感信息备选 (双重保险)
# ==========================================
.env
*.key
*.pem
credentials.json
