    "guideInitial": 0.8,
    "guideDecay": 0.7,
    "guideMin": 0.18,
    "guideHover": 0.85,
    "icons": {
      "enableFolderIcons": false,
      "enableFileIcons": true,
      "iconGap": 0,
      "iconVerticalOffset": 0,
      "folderIcons": [
        {
          "path": "0_收集箱",
